# Porta do servidor HTTP
PORT=3000

# Driver do repositorio: "memory" (padrao, sem banco) ou "postgres"
REPO_DRIVER=memory

# String de conexao usada quando REPO_DRIVER=postgres
DATABASE_URL=postgres://taskflow:taskflow_dev@localhost:5432/taskflow

# Credenciais usadas pelo docker-compose.
# Em homologacao e producao estes valores vem dos Secrets do GitHub,
# nunca deste arquivo. O .env real fica fora do Git (ver .gitignore).
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev
POSTGRES_DB=taskflow

# Tag da imagem usada pelo compose (local, latest, 0.2.0...)
TAG=local
